# Local development only. In Kubernetes these come from a ConfigMap (non-secret)
# and Infisical-synced Secrets; no .env file exists there.
# Read by the backend (pydantic-settings) and by docker-compose.dev.yml (postgres).

# ── Database ────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_USER=**
POSTGRES_PASSWORD=**
POSTGRES_DB=**
# DB_ECHO=true   # log every SQL statement

# ── Auth ────────────────────────────────────────────────────
# openssl rand -base64 64 | tr -d '\n'
JWT_SECRET_KEY=**
# Comma-separated browser origins (CORS + chat WebSocket)
CORS_ORIGINS=http://localhost:3000

# ── LLMs ────────────────────────────────────────────────────
OPENROUTER_API_KEY=**
# Optional overrides (OpenRouter model ids)
# LLM_MODEL=deepseek/deepseek-v4-pro
# LLM_FAST_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# ── Anki ────────────────────────────────────────────────────
ANKI_URL=http://localhost:8765

# ── Firebase ────────────────────────────────────────────────
FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
# The service-account key is found via the standard GOOGLE_APPLICATION_CREDENTIALS
# env var. It must be a real environment variable (Google's library does not read
# this file); `make dev` exports it, defaulting to backend/firebaseServiceAccount.json.

# ── Telemetry ───────────────────────────────────────────────
OTEL_ENABLED=false
OTEL_ENDPOINT=localhost:4317

# LangSmith tracing (read by LangChain from the process environment)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=**
# LANGSMITH_PROJECT=**
