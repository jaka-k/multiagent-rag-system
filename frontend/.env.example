# Runtime configuration for the frontend. All of it is read when the server
# starts or renders, never at build time, so one image serves every environment.
# Locally: copy to .env.local. In Kubernetes: set as env vars on the Deployment.

# ── Server-side only ────────────────────────────────────────
# Backend as reachable from the Next.js server (in-cluster: the Service address)
BACKEND_URL=http://localhost:8080
# "prod" enables secure cookies
ENVIRONMENT=dev
# LOG_LEVEL=info

# ── Public (sent to the browser, see src/lib/runtime-config) ───────────
# Backend as reachable from the user's browser (REST, SSE; WebSocket uses ws/wss)
BACKEND_PUBLIC_URL=http://localhost:8080
# Firebase web app config (public by design)
FIREBASE_API_KEY=**
FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
FIREBASE_PROJECT_ID=<project-id>
FIREBASE_STORAGE_BUCKET=<project-id>.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=**
FIREBASE_APP_ID=**

# ── Tracing (optional) ──────────────────────────────────────
# OTEL_ENABLED=true
# OTEL_ENDPOINT=localhost:4317
